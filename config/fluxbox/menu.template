[begin] (Antigravity)
  [exec] (Terminal) {xterm}
  [exec] (Browser) {{{BROWSER_CMD}} about:blank}
  [separator]
  [submenu] (VPN)
    [exec] (VPN Status) {xterm -e bash -c "curl -s --proxy socks5h://127.0.0.1:{{SOCKS_PORT}} https://ifconfig.me; echo; read -p 'Press Enter...'"}
    [exec] (VPN Log) {xterm -e tail -f {{VPN_LOG_FILE}}}
  [end]
  [submenu] (Logs)
    [exec] (App Log) {xterm -e tail -f {{LOG_FILE}}}
    [exec] (VPN Log) {xterm -e tail -f {{VPN_LOG_FILE}}}
  [end]
  [separator]
  [exec] (Status) {xterm -e bash -c "{{SCRIPT_DIR}}/status-vnc.sh; read -p 'Press Enter...'"}
  [separator]
  [exit] (Exit)
[end]
