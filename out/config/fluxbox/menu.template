[begin] (Antigravity Desktop)
  [submenu] (Terminal)
    [exec] (XTerm) {xterm -fa "DejaVu Sans Mono" -fs 11}
    [exec] (XTerm Dark) {xterm -bg black -fg white -fa "DejaVu Sans Mono" -fs 11}
    [exec] (XTerm Large) {xterm -bg black -fg green -fa "DejaVu Sans Mono" -fs 14}
    [exec] (Bash Login) {xterm -e bash --login}
  [end]
  [submenu] (Web Browser)
    [exec] (Chromium) {env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u SOCKS_PROXY -u socks_proxy {{BROWSER_CMD}}}
    [exec] (Chromium — google.com) {env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u SOCKS_PROXY -u socks_proxy {{BROWSER_CMD}} https://www.google.com}
    [exec] (Chromium — check IP) {env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u SOCKS_PROXY -u socks_proxy {{BROWSER_CMD}} https://ifconfig.me}
    [separator]
    [exec] (Chromium 🔒 VPN) {{{BROWSER_PROXY_CMD}}}
    [exec] (Chromium 🔒 VPN — google.com) {{{BROWSER_PROXY_CMD}} https://www.google.com}
    [exec] (Chromium 🔒 VPN — check IP) {{{BROWSER_PROXY_CMD}} https://ifconfig.me}
    [separator]
    [exec] (Camoufox #1) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u SOCKS_PROXY -u socks_proxy {{CAMOUFOX_BROWSER1_CMD}}}
    [exec] (Camoufox #1 — google.com) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u SOCKS_PROXY -u socks_proxy {{CAMOUFOX_BROWSER1_CMD}} https://www.google.com}
    [exec] (Camoufox #2) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u SOCKS_PROXY -u socks_proxy {{CAMOUFOX_BROWSER2_CMD}}}
    [exec] (Camoufox #2 — check IP) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u SOCKS_PROXY -u socks_proxy {{CAMOUFOX_BROWSER2_CMD}} https://ifconfig.me}
    [separator]
    [exec] (Camoufox 🔒 VPN) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log {{CAMOUFOX_PROXY_CMD}}}
    [exec] (Camoufox 🔒 VPN — google.com) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log {{CAMOUFOX_PROXY_CMD}} https://www.google.com}
    [exec] (Camoufox 🔒 VPN — check IP) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log {{CAMOUFOX_PROXY_CMD}} https://ifconfig.me}
    [separator]
    [exec] (Antigravity) {env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u SOCKS_PROXY -u socks_proxy {{ANTIGRAVITY_CMD}}}
    [separator]
    [exec] (Antigravity 🔒 VPN) {{{ANTIGRAVITY_PROXY_CMD}}}
  [end]
  [submenu] (WARP Proxy)
    [exec] (Chromium 🌐 WARP) {{{BROWSER_WARP_CMD}}}
    [exec] (Chromium 🌐 WARP — google.com) {{{BROWSER_WARP_CMD}} https://www.google.com}
    [exec] (Chromium 🌐 WARP — check IP) {{{BROWSER_WARP_CMD}} https://ifconfig.me}
    [separator]
    [exec] (Camoufox 🌐 WARP) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log {{CAMOUFOX_WARP_CMD}}}
    [exec] (Camoufox 🌐 WARP — google.com) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log {{CAMOUFOX_WARP_CMD}} https://www.google.com}
    [exec] (Camoufox 🌐 WARP — check IP) {FLUXBOX_DEBUG_LOG=~/.fluxbox-debug.log {{CAMOUFOX_WARP_CMD}} https://ifconfig.me}
    [separator]
    [exec] (Antigravity 🌐 WARP) {{{ANTIGRAVITY_WARP_CMD}}}
    [separator]
    [exec] (Start WARP) {xterm -fa "DejaVu Sans Mono" -fs 11 -hold -e bash -lc 'cd {{SCRIPT_DIR}} && bash scripts/start-warp.sh start'}
    [exec] (Stop WARP) {xterm -fa "DejaVu Sans Mono" -fs 11 -hold -e bash -lc 'cd {{SCRIPT_DIR}} && bash scripts/start-warp.sh stop'}
    [exec] (WARP Status) {xterm -fa "DejaVu Sans Mono" -fs 11 -hold -e bash -lc 'cd {{SCRIPT_DIR}} && bash scripts/start-warp.sh status'}
    [exec] (Check WARP IP) {xterm -fa "DejaVu Sans Mono" -fs 11 -hold -e bash -lc 'echo "=== WARP IP ==="; curl -s --connect-timeout 5 --proxy socks5h://127.0.0.1:{{WARP_SOCKS_PORT}} https://ifconfig.me 2>/dev/null || echo FAILED; echo; echo "=== Direct IP ==="; env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY curl -s --connect-timeout 5 https://ifconfig.me 2>/dev/null || echo FAILED; echo'}
    [exec] (WARP Log) {xterm -fa "DejaVu Sans Mono" -fs 11 -e bash -lc 'tail -50f {{WIREPROXY_LOG_FILE}}'}
  [end]
  [submenu] (Tools)
    [exec] (File Listing) {xterm -fa "DejaVu Sans Mono" -fs 11 -e bash -lc 'ls -la ~; echo "---"; read -rp "Press Enter..."'}
    [exec] (Disk Usage) {xterm -fa "DejaVu Sans Mono" -fs 11 -e bash -lc 'df -h; echo "---"; read -rp "Press Enter..."'}
    [exec] (Processes) {xterm -fa "DejaVu Sans Mono" -fs 11 -e bash -lc 'ps aux; echo "---"; read -rp "Press Enter..."'}
    [exec] (Network Info) {xterm -fa "DejaVu Sans Mono" -fs 11 -e bash -lc 'echo "Hostname: $(hostname)"; echo; ip addr 2>/dev/null || ifconfig 2>/dev/null; echo "---"; read -rp "Press Enter..."'}
  [end]
  [submenu] (VPN)
    [exec] (VPN Status) {xterm -fa "DejaVu Sans Mono" -fs 11 -hold -e bash -lc 'cd {{SCRIPT_DIR}} && bash status-vnc.sh'}
    [exec] (Check VPN IP) {xterm -fa "DejaVu Sans Mono" -fs 11 -hold -e bash -lc 'echo "=== VPN IP ==="; curl -s --connect-timeout 5 --proxy socks5h://127.0.0.1:{{SOCKS_PORT}} https://ifconfig.me 2>/dev/null || echo FAILED; echo; echo "=== Direct IP ==="; env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY curl -s --connect-timeout 5 https://ifconfig.me 2>/dev/null || echo FAILED; echo'}
    [exec] (VPN Log) {xterm -fa "DejaVu Sans Mono" -fs 11 -e bash -lc 'tail -50f {{VPN_LOG_FILE}}'}
    [exec] (App Log) {xterm -fa "DejaVu Sans Mono" -fs 11 -e bash -lc 'tail -50f {{LOG_FILE}}'}
  [end]
  [separator]
  [submenu] (Fluxbox)
    [workspaces] (Workspaces)
    [submenu] (Styles)
      [stylesdir] (/usr/share/fluxbox/styles)
      [stylesdir] (~/.fluxbox/styles)
    [end]
    [config] (Configure)
    [reconfig] (Reconfigure)
    [restart] (Restart Fluxbox)
  [end]
  [separator]
  [exit] (Exit Fluxbox)
[end]
