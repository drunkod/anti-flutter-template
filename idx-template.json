{
  "name": "Flutter",
  "description": "Flutter create template",
  "categories": ["Mobile"],
  "icon": "https://www.gstatic.com/images/branding/productlogos/flutter/v6/192px.svg",
  "publisher": "Rody Davis",
  "host": {
    "virtualization": true
  },
  "params": [
    {
      "id": "platforms",
      "name": "Platforms",
      "type": "text",
      "default": "web"
    },
    {
      "id": "camoufox",
      "name": "Enable Camoufox (anti-detect browser)",
      "type": "boolean",
      "default": "true"
    },
    {
      "id": "warp",
      "name": "Enable WARP VPN",
      "type": "boolean",
      "default": "false"
    }
  ]
}
