# Use ${VAR:-default} so callers can override (e.g. IDX sets NOVNC_PORT=$PORT)

if [ -n "${UID:-}" ]; then
    # Offset by 10 to avoid low displays, modulo to keep it reasonable
    DEFAULT_DISPLAY_NUM=$((UID % 100 + 10))
    DEFAULT_VNC_PORT=$((5900 + DEFAULT_DISPLAY_NUM))
    DEFAULT_NOVNC_PORT=$((6000 + DEFAULT_DISPLAY_NUM))
else
    DEFAULT_DISPLAY_NUM=99
    DEFAULT_VNC_PORT=5900
    DEFAULT_NOVNC_PORT=5999
fi

DISPLAY_NUM="${DISPLAY_NUM:-$DEFAULT_DISPLAY_NUM}"
VNC_PORT="${VNC_PORT:-$DEFAULT_VNC_PORT}"
NOVNC_PORT="${NOVNC_PORT:-$DEFAULT_NOVNC_PORT}"
SOCKS_PORT="${SOCKS_PORT:-10808}"
HTTP_PORT="${HTTP_PORT:-10809}"

PID_FILE="$HOME/.antigravity-vnc.pid"
LOCK_FILE="$HOME/.antigravity-vnc.lock"
LOG_FILE="$HOME/.antigravity-vnc.log"

VPN_PID_FILE="$HOME/.xray-vpn.pid"
VPN_LOG_FILE="$HOME/.xray-vpn.log"
PROXY_ENV_FILE="$HOME/.xray-proxy.env"
PROXYCHAINS_CONF="$HOME/.proxychains.conf"

VPN_CONFIG_FILE="v2ray-client.json"
VPN_REALITY_CONFIG_FILE="v2ray-client-reality.json"
VPN_CONFIG_EXAMPLE_FILE="v2ray-client.json.example"
VPN_REALITY_CONFIG_EXAMPLE_FILE="v2ray-client-reality.json.example"

BROWSER_CMD="$HOME/.local/bin/browser"
CAMOUFOX_BROWSER1_CMD="$HOME/.local/bin/camoufox-browser-1"
CAMOUFOX_BROWSER2_CMD="$HOME/.local/bin/camoufox-browser-2"

NOVNC_URL_DEFAULT="https://5999-firebase-antigravity-1763533608633.cluster-iusnsmywp5clov45nv5gsxt5he.cloudworkstations.dev/vnc.html"

_extract_host_from_value() {
    local value="$1"
    value="${value#http://}"
    value="${value#https://}"
    value="${value%%/*}"
    printf '%s' "${value%%:*}"
}

_detect_workstation_host() {
    local candidate
    for candidate in \
        "${CLOUD_WORKSTATION_HOST:-}" \
        "${CLOUD_WORKSTATION_FQDN:-}" \
        "${CLOUD_WORKSTATION_HOSTNAME:-}" \
        "${CLOUD_WORKSTATION_URL:-}" \
        "${WORKSTATION_HOST:-}" \
        "${HOSTNAME:-}"; do
        [ -n "$candidate" ] || continue
        candidate="$(_extract_host_from_value "$candidate")"
        if [ -n "$candidate" ] && [[ "$candidate" == *".cloudworkstations.dev" ]]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

WORKSTATION_HOST="$(_detect_workstation_host || _extract_host_from_value "$NOVNC_URL_DEFAULT")"
WORKSTATION_DOMAIN="${WORKSTATION_DOMAIN:-$WORKSTATION_HOST}"

NOVNC_HOST="$WORKSTATION_HOST"
case "$NOVNC_HOST" in
    "${NOVNC_PORT}-"*) ;;
    *) NOVNC_HOST="${NOVNC_PORT}-${NOVNC_HOST}" ;;
esac

NOVNC_URL_AUTO="https://${NOVNC_HOST}/vnc.html"
NOVNC_URL="${NOVNC_URL:-$NOVNC_URL_AUTO}"

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/xdg-runtime-$USER}"
